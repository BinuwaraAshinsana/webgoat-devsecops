# ---------------------------------------------------------------------------
# WebGoat DevSecOps — example environment file
#
# Copy this file to `.env` and edit the values. `.env` is gitignored and must
# never be committed; this file is the committed template and must only ever
# contain placeholder values.
#
#     cp .env.example .env
#
# docker-compose.yml reads these variables: it interpolates ${VARIABLE} from this
# .env (once copied) and passes them into the container, with the ":-default"
# fallbacks in the compose file used when a variable is unset. Every name below is
# read by src/main/resources/application-webgoat.properties or
# application-webwolf.properties. In the CI pipeline the same variables are provided
# by GitHub Actions encrypted secrets, not by this file.
# ---------------------------------------------------------------------------

# --- Container ---------------------------------------------------------------
TZ=Asia/Colombo

# --- WebGoat -----------------------------------------------------------------
# Bind address inside the container. Use 0.0.0.0 when running under Docker so
# the port is reachable from the host; compose still publishes on 127.0.0.1 only.
WEBGOAT_HOST=0.0.0.0
WEBGOAT_PORT=8080
WEBGOAT_CONTEXT=/WebGoat

# --- WebWolf -----------------------------------------------------------------
WEBWOLF_HOST=0.0.0.0
WEBWOLF_PORT=9090
WEBWOLF_CONTEXT=/WebWolf

# --- TLS ---------------------------------------------------------------------
# Disabled by default. If you enable it, supply a real keystore and set the
# password here — never in application-webgoat.properties.
WEBGOAT_SSLENABLED=false
WEBGOAT_KEYSTORE_TYPE=PKCS12
WEBGOAT_KEYSTORE=classpath:goatkeystore.pkcs12
WEBGOAT_KEYSTORE_PASSWORD=changeme
WEBGOAT_KEY_ALIAS=goat

# --- GitHub OAuth (optional; only needed for the OAuth lessons) --------------
# Real values belong in `.env` locally and in GitHub Actions encrypted secrets
# for the pipeline. Placeholders only in this file.
WEBGOAT_OAUTH_CLIENTID=changeme
WEBGOAT_OAUTH_CLIENTSECRET=changeme
WEBWOLF_OAUTH_CLIENTID=changeme
WEBWOLF_OAUTH_CLIENTSECRET=changeme

# --- Lesson filtering (optional) ---------------------------------------------
# Comma-separated. Leave as `none,none` to load everything.
EXCLUDE_CATEGORIES=none,none
EXCLUDE_LESSONS=none,none
